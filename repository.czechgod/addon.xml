<?xml version="1.0" encoding="UTF-8"?>
<addon id="repository.czechgod"
       name="CzechGod Add-on Repository"
       version="1.0.3"
       provider-name="CzechGod">

    <extension point="xbmc.addon.repository">
        <dir>
            <info compressed="false">https://raw.githubusercontent.com/CzechGod/kodi-addons/main/addons.xml</info>
            <checksum>https://raw.githubusercontent.com/CzechGod/kodi-addons/main/addons.xml.md5.txt</checksum>
            <datadir zip="true">https://raw.githubusercontent.com/CzechGod/kodi-addons/main/</datadir>
        </dir>
    </extension>

    <extension point="xbmc.addon.metadata">
        <summary lang="en_GB">CzechGod Kodi add-on repository</summary>
        <description lang="en_GB">Repository for CzechGod Kodi add-ons</description>
        <platform>all</platform>
    </extension>

</addon>